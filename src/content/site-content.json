  "sections": {
    "how_it_works": {
      "caption": "How it works",
      "title": {
        "line1": "Superpowered coordination",
        "line2": "through integration of",
        "line3": "Holochain and REA grammars"
      },
      "features": [
        {
          "title": "Simple, composable, and modular economic building blocks",
          "description": "Mix and match the building blocks of hREA's economic kit into something tailored to your needs, minimizing technical overhead."
        },
        {
          "title": "Economic coordination on Distributed Ledger Technology",
          "description": "Multiple secure network spaces can exist simultaneously and scale to any size, enabling you to strike the perfect balance between data privacy and data commons. Participant relationships form the connections between networks, just like in the real world."
        },
        {
          "title": "Bring-your-own-user-interface with hREA's Valueflows API",
          "description": "Get an entire backend system out-of-the-box and leverage powerful general-purpose economic planning & accounting tools. Build the tailor-made user interfaces that your scenario needs with our extensively documented APIs and frontend libraries."
        }
      ]
    },
    "who_is_for": {
      "caption": "Who is hREA for",
      "title": {
        "line1": "hREA enables tracking & tracing",
        "line2": "value flows for conventional",
        "line3": "and alternative economies alike"
      },
      "audiences": [
        {
          "highlight": "cross-stakeholder value chains",
          "description": "(think supply chains, joint ventures, multi-company collaboration spaces, cooperative and small business economic networks, and more)"
        },
        {
          "highlight": "loosely coupled economic coordination",
          "description": "(think open source projects, artistic collectives, eco villages, makerspaces, mutual credit & mutual aid networks, open value networks, DAOs, and more)"
        }
      ]
    },
    "roadmap": {
      "caption": "History and Roadmap",
      "phases": [
        {
          "title": "\"Seed\" Stage",
          "period": "September 2018 - December 2018",
          "items": [
            {
              "text": "Led by David Hand, hREA project was started, called HoloREA initially.",
              "link": [
                {
                  "text": "David Hand",
                  "url": "https://github.com/sqykly"
                }
              ]
            },
            {
              "text": "A demo app was created in Go during Holochain's Go phase."
            }
          ]
        },
        {
          "title": "\"Sprout\" Stage",
          "period": "January 2019 - April 2022",
          "items": [
            {
              "text": "Led by pospi, hREA project moved to Rust and was continued through ad hoc development.",
              "link": [
                {
                  "text": "pospi",
                  "url": "https://pospi.spadgos.com"
                }
              ]
            },
            {
              "text": "Around 70% towards the goal of usability of the API for developers accomplished (to be able to implement applications on top of API)."
            }
          ]
        },
        {
          "title": "First Major Milestone Release (\"Sapling\")",
          "period": "May 2022 - September 2022",
          "items": [
            {
              "text": "Led by Sprillow, hREA reached a fully usable API (v0.1.0-beta).",
              "link": [
                {
                  "text": "Sprillow",
                  "url": "https://sprillow.com"
                }
              ]
            },
            {
              "text": "Launched accompanying documentation at docs.hrea.io.",
              "link": [
                {
                  "text": "docs.hrea.io",
                  "url": "https://docs.hrea.io"
                }
              ]
            }
          ]
        },
        {
          "title": "\"Tree\" Stage",
          "period": "October 2022 - August 2025",
          "items": [
            {
              "text": "Led by Leo Bensman, through Lightningrod Labs, the first applications on top of hREA began to be built.",
              "link": [
                {
                  "text": "Leo Bensman",
                  "url": "https://www.linkedin.com/in/leo-bensman/"
                },
                {
                  "text": "Lightningrod Labs",
                  "url": "https://lightningrodlabs.org/"
                }]
            },
            {
              "text": "Based on user and developer feedback, hREA continued to be enhanced, including..."
            },
            { "text": "Full rewrite for performance, integration with Moss." }
          ]
        },
        {
          "title": "Growing in the Forest",
          "period": "September 2025 onward",
          "items": [
            {
              "text": "Continuing to be led by Leo Bensman, in collaboration with the Holochain Foundation.",
              "link": [
                {
                  "text": "Leo Bensman",
                  "url": "https://www.linkedin.com/in/leo-bensman/"
                },
                {
                  "text": "Holochain Foundation",
                  "url": "https://www.holochain.org/foundation/"
                }
              ]
            },
            {
              "text": "Enhancements based on application project feedback continue."
            },
            { "text": "The hREA's Community of Practice is being grown." },
            { "text": "Sustainable funding patterns are being built." }
          ]
        }
      ]
    },
