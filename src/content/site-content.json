    },
    "description": {
      "intro": "hREA",
      "holochain_text": "Holochain",
      "holochain_url": "https://www.holochain.org/",
      "rea_text": "Resource-Event-Agent",
      "rea_url": "https://en.wikipedia.org/wiki/Resources%2C_Events%2C_Agents",
      "valueflows_text": "Valueflows",
      "valueflows_url": "http://valueflo.ws/",
      "main_description": "specification. It enables a transparent and trusted account of resource and information flows between decentralized and independent agents, across and within ecosystems."
    },
    "buttons": {
      "learn_more": {
        "text": "Learn more",
